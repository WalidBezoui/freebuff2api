# freebuff2api 环境变量示例（复制为 .env 使用；.env 已被 .gitignore 忽略，绝不提交）

# 必填：API 访问密钥（客户端 Authorization: Bearer <key>）。
# 不设置 → 所有请求返回 401（fail-closed，无默认密钥后门）。
FREEBUFF_API_KEY=

# 必填：Codebuff 账号 token（逗号/换行分隔多账号，支持 token:uid 配对）
FREEBUFF_TOKEN=

# 可选
FREEBUFF_DEBUG=false
PORT=8787
HOST=0.0.0.0

# 可选：工具（exec/Bash）结果回传上游前的最大长度（字符），0 = 不限；缺省 32768。
# 防止长会话上下文被单次巨型输出撑爆（Codex / Claude Code 均生效）。
FREEBUFF_MAX_TOOL_OUTPUT=32768

# 可选：DeepSeek 无 effort 请求时的默认推理档（P1）；缺省 max。
# session 按创建计费、turn 内免费，max 无额外 quota 成本，仅首 token 稍慢。
# 显式传入的 effort 永远优先；非法值回退 max；最终仍按模型 efforts 表 clamp。
# FREEBUFF_DEFAULT_EFFORT=max

# 可选：DeepSeek 回退模式开关（P2）：DSML/XML 全失败时把单个 ```bash 块当 exec；
# 设为 0 关闭（Anthropic 保留原名路径永远不触发）。缺省开启。
# FREEBUFF_BASH_FALLBACK=1

# 可选：read_file 单文件体积上限（字节），0 = 不限；缺省 524288（512KB）。
# 超限时 exec 脚本直接 exit 1，避免巨型日志/二进制拖死沙箱。
# FREEBUFF_MAX_READ_FILE_BYTES=524288

# 可选：DeepSeek 工具引导提示（P8）：工具会话自动注入短版 system 提示
#（优先 write_file/apply_patch、工具前一句话意图、同命令失败换策略）。
# 设为 0 关闭。缺省开启；纯问答（无 tools）不注入。
# FREEBUFF_DEEPSEEK_HINTS=1

# 可选：重试循环提醒（P9）：同一命令连续失败达阈值时在 tool 结果尾注记一次，
# 打破裸重试循环；非零 exit code 恒透传（P9a，无开关）。设为 0 关闭。
# FREEBUFF_LOOP_NUDGE=1
# 可选：注记触发阈值（同命令连续失败次数，缺省 3，最小 2）。
# FREEBUFF_LOOP_THRESHOLD=3

# 可选：自建中继（默认直连 https://www.codebuff.com）
# CODEBUFF_API=
# RELAY_KEY=