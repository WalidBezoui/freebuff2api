# freebuff2api 环境变量示例（复制为 .env 使用；.env 已被 .gitignore 忽略，绝不提交）

# 必填：API 访问密钥（客户端 Authorization: Bearer <key>）。
# 不设置 → 所有请求返回 401（fail-closed，无默认密钥后门）。
FREEBUFF_API_KEY=

# 必填：Codebuff 账号 token（逗号/换行分隔多账号，支持 token:uid 配对）
FREEBUFF_TOKEN=

# 可选
FREEBUFF_DEBUG=false
PORT=8787
HOST=0.0.0.0

# 可选：自建中继（默认直连 https://www.codebuff.com）
# CODEBUFF_API=
# RELAY_KEY=